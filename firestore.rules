rules_version = '2';
// Classement de Flappy Seb. À coller dans la console Firebase : Firestore > Règles.
// Lecture ouverte. Une fiche de joueur ne peut que grandir, une partie ne peut qu'être ajoutée. Aucune suppression.
service cloud.firestore {
  match /databases/{database}/documents {
    function okName(d) { return d.name is string && d.name.size() >= 2 && d.name.size() <= 14; }
    // Entier borné qui ne descend pas sous l'ancienne valeur
    function up(n, o, k, max) { return n[k] is int && n[k] >= o.get(k, 0) && n[k] <= max; }
    function okMinis(n, o) {
      return n is map
        && n.keys().hasOnly(['invaders', 'breakout', 'dino', 'canon', 'whack', 'catch', 'pong', 'shell', 'race', 'tusmo', 'g2048', 'suika', 'crossy', 'stack', 'ninja', 'piano', 'surv', 'jump'])
        && n.get('invaders', 0) >= o.get('invaders', 0) && n.get('breakout', 0) >= o.get('breakout', 0)
        && n.get('dino', 0) >= o.get('dino', 0) && n.get('canon', 0) >= o.get('canon', 0)
        && n.get('whack', 0) >= o.get('whack', 0) && n.get('catch', 0) >= o.get('catch', 0)
        && n.get('pong', 0) >= o.get('pong', 0) && n.get('shell', 0) >= o.get('shell', 0)
        && n.get('race', 0) >= o.get('race', 0) && n.get('tusmo', 0) >= o.get('tusmo', 0)
        && n.get('g2048', 0) >= o.get('g2048', 0) && n.get('suika', 0) >= o.get('suika', 0)
        && n.get('crossy', 0) >= o.get('crossy', 0) && n.get('stack', 0) >= o.get('stack', 0)
        && n.get('ninja', 0) >= o.get('ninja', 0) && n.get('piano', 0) >= o.get('piano', 0)
        && n.get('surv', 0) >= o.get('surv', 0) && n.get('jump', 0) >= o.get('jump', 0);
    }
    function okPlayer(n, o) {
      return n.keys().hasOnly(['name', 'best', 'level', 'dist', 'at', 'minis', 'games', 'pigeons', 'toasters', 'mines', 'walls', 'coins', 'bosses', 'perfect', 'graze'])
        && okName(n) && n.at is int
        && up(n, o, 'best', 100000) && up(n, o, 'level', 1000) && up(n, o, 'dist', 1000000) && up(n, o, 'games', 1000000)
        && up(n, o, 'pigeons', 10000000) && up(n, o, 'toasters', 10000000) && up(n, o, 'mines', 10000000) && up(n, o, 'walls', 10000000)
        && up(n, o, 'coins', 10000000) && up(n, o, 'bosses', 1000000) && up(n, o, 'perfect', 1000000) && up(n, o, 'graze', 10000000)
        && okMinis(n.minis, o.get('minis', {}));
    }

    match /players/{id} {
      allow read: if true;
      allow create: if okPlayer(request.resource.data, {});
      allow update: if okPlayer(request.resource.data, resource.data);
    }
    match /runs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'level', 'dist', 'at'])
        && okName(request.resource.data) && request.resource.data.at is int
        && up(request.resource.data, {}, 'score', 100000) && up(request.resource.data, {}, 'level', 1000) && up(request.resource.data, {}, 'dist', 1000000);
    }
  }
}
